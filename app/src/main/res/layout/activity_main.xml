<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fundo_hero"
            android:padding="24dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@android:drawable/ic_lock_lock"
                android:padding="12dp"
                android:background="@color/borda"
                app:tint="@color/texto"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Monitor"
                android:textColor="@color/texto"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sincronização segura em segundo plano"
                android:textColor="#C7D6E8"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/superficie"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/borda"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURAÇÃO"
                    android:textColor="@color/texto_fraco"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/linha_permissoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_permissoes"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/vermelho" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Permissões"
                        android:textColor="@color/texto"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/est_permissoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pendente"
                        android:textColor="@color/texto_fraco"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linha_acessibilidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_acessibilidade"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/vermelho" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Acessibilidade"
                        android:textColor="@color/texto"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/est_acessibilidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pendente"
                        android:textColor="@color/texto_fraco"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linha_bateria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_bateria"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/vermelho" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Bateria"
                        android:textColor="@color/texto"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/est_bateria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pendente"
                        android:textColor="@color/texto_fraco"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linha_servico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_servico"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/vermelho" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Monitoramento"
                        android:textColor="@color/texto"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/est_servico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="parado"
                        android:textColor="@color/texto_fraco"
                        android:textSize="13sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progresso"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="18dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/verde"
                    android:progressBackgroundTint="@color/borda" />

                <TextView
                    android:id="@+id/resumo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Toque em ativar. O app cuida do resto."
                    android:textColor="@color/texto_fraco"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ativar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="Ativar tudo"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_avancado"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Avançado"
            app:cornerRadius="18dp" />

        <LinearLayout
            android:id="@+id/painel_avancado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_testar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Testar Telegram" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_parar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parar monitor" />

            <TextView
                android:id="@+id/detalhes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/texto_fraco"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>